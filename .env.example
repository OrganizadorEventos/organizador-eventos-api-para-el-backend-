# Puerto del servidor API
PORT=4000

# Secreto para firmar JWT (cambiarlo en producción)
JWT_SECRET=cambiar-este-secreto-en-produccion

# Orígenes permitidos por CORS (separados por coma). '*' = todos.
# CORS_ORIGIN=http://localhost:5173,https://tu-front.vercel.app

# Ruta del archivo SQLite (la BD se crea sola si no existe)
# DB_FILE=./data/organizador.db

# Proyecto Supabase (mantener los valores reales solo en .env local)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
